PORT=3000

# Vapi API Key (Get this from https://dashboard.vapi.ai)
VAPI_API_KEY=your_vapi_private_key_here

# Your Phone Number to call for testing (format: +1234567890)
TEST_PHONE_NUMBER=your_test_phone_number_here

# Vapi Assistant ID (Create an assistant in the dashboard and paste the ID here)
VAPI_ASSISTANT_ID=your_assistant_id_here
